# TMDB API Configuration
# Get your free API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Base Stream URL
# This is the base URL for your streaming service
# The app will construct URLs as:
# - Movies: {BASE_STREAM_URL}/movie/{tmdb_id}
# - TV Shows: {BASE_STREAM_URL}/tv/{tmdb_id}/{season}/{episode}
BASE_STREAM_URL=https://player.videasy.net

# Example URLs that will be generated:
# Movie: https://player.videasy.net/movie/550 (Fight Club)
# TV Show: https://player.videasy.net/tv/1399/1/1 (Game of Thrones S01E01)

# MangaPlus API
EXPO_PUBLIC_MANGAPLUS_BASE_URL=https://your-mangaplus-api-url.com/api
