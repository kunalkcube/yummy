# TMDB API Configuration
# Get your free API key from: https://www.themoviedb.org/settings/api
# Optional local reference — the app reads TMDB credentials from Settings
TMDB_API_KEY=your_tmdb_api_key_here

# Base Stream URL (optional local reference)
# Custom stream bases are configured in Settings after accepting the stream notice
BASE_STREAM_URL=https://player.videasy.net
